{
  "manifest_version": 3,
  "name": "TypeByAman",
  "version": "1.0.0",
  "description": "A premium local typing/replay utility. Type. Replay. Create. — by Aman Kumar",
  "author": "Aman Kumar",
  "homepage_url": "https://amankr0075.github.io/TypeByAman/",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TypeByAman — Type. Replay. Create.",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "start-typing": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Start typing"
    },
    "pause-resume-typing": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Pause / Resume typing"
    },
    "stop-typing": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Stop typing"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "content/design-engine.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}